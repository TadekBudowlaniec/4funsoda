# ─── HTTPS + www → non-www ────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Wymuś HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → goły domain (zmień jeśli chcesz odwrotnie)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  DirectoryIndex index.html

  # ── Strony miast to katalogi: m/<slug>/index.html — /m/lukow/ działa
  # natywnie przez DirectoryIndex, bez żadnych rewrite'ów.
  # Stare płaskie URL-e /m/lukow.html → 301 na /m/lukow/.
  # index.html przepuszczamy wprost (bez lookahead — pełna zgodność z LiteSpeed).
  RewriteRule ^m/index\.html$ - [L]
  RewriteRule ^m/([a-z0-9-]+)\.html$ /m/$1/ [R=301,L]

  # ── SPA fallback: tylko dla ścieżek, które nie są plikiem ani katalogiem
  # i nie należą do statycznych zasobów ani API.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/m/
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_URI} !^/favicon
  RewriteRule ^ /index.html [L]
</IfModule>

# ─── MIME types (na wypadek złej konfiguracji hostingu) ───────────────────
<IfModule mod_mime.c>
  AddType image/svg+xml             .svg
  AddType application/manifest+json .webmanifest
  AddType application/wasm          .wasm
  AddType font/woff2                .woff2
</IfModule>

# ─── Kompresja (gzip / brotli jeśli dostępne) ─────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ─── Cache headers ────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — krótki cache (bo to bramka do SPA)
  ExpiresByType text/html                       "access plus 5 minutes"

  # Hashowane assety Vite (zawierają hash w nazwie) — cache na rok
  <FilesMatch "\.(js|css|woff2|woff|ttf|eot|otf|jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # XML / sitemap / manifesty — średni cache
  ExpiresByType application/xml                 "access plus 1 day"
  ExpiresByType application/manifest+json       "access plus 1 day"
  ExpiresByType text/xml                        "access plus 1 day"
</IfModule>

# ─── Security headers ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

# ─── Wyłącz listing katalogów ─────────────────────────────────────────────
Options -Indexes

# ─── Strony błędów (opcjonalnie) ──────────────────────────────────────────
ErrorDocument 404 /index.html
